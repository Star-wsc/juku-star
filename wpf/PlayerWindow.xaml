<Window x:Class="JukuWpf.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="播放" Height="720" Width="1180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FocusVisualStyle="{x:Null}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="12" Background="#0A0A0C" ClipToBounds="True">
        <Grid x:Name="Root" Background="#0A0A0C">

            <MediaElement x:Name="Player" Panel.ZIndex="0"
                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Stretch="Uniform" Volume="0.8"
                          MediaOpened="Player_MediaOpened"
                          MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"/>

            <!-- 顶栏 -->
            <Grid x:Name="TopBar" Panel.ZIndex="20" Height="48" VerticalAlignment="Top"
                  Background="#F0121216" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <TextBlock Text="剧" FontSize="12" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="选集" Click="ToggleEpisodes_Click" Width="56" Height="48"
                            Style="{StaticResource BtnDark}" Focusable="False"/>
                    <!-- 窗控：图标样式 -->
                    <Button Width="46" Height="48" Click="Min_Click" Background="Transparent"
                            BorderThickness="0" Focusable="False">
                        <TextBlock Text="—" Foreground="#A0A0A8" FontSize="14"/>
                    </Button>
                    <Button Width="46" Height="48" Click="Max_Click" Background="Transparent"
                            BorderThickness="0" Focusable="False">
                        <Rectangle Width="10" Height="10" Stroke="#A0A0A8" StrokeThickness="1.2"/>
                    </Button>
                    <Button Width="46" Height="48" Click="Close_Click" Background="Transparent"
                            BorderThickness="0" Focusable="False">
                        <TextBlock Text="✕" Foreground="#A0A0A8" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 底部控制 -->
            <Border x:Name="OverlayBar" Panel.ZIndex="20" VerticalAlignment="Bottom"
                    Background="#F0121216" Padding="20,16">
                <StackPanel>
                    <!-- 进度：纯轨道 + 填充，不要 Thumb（默认 Thumb 是一坨白） -->
                    <Border x:Name="SeekTrack" Height="6" Margin="0,0,0,14"
                          Background="#33FFFFFF" CornerRadius="3"
                          MouseLeftButtonUp="SeekGrid_Click">
                        <Border x:Name="SeekFill" Background="{StaticResource Accent}" CornerRadius="3"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PlayPauseBtn" Content="播放" Click="PlayPause_Click"
                                    Width="88" Height="36" FontSize="13" Style="{StaticResource BtnAccent}" Focusable="False"/>
                            <Button Content="后退10秒" Tag="-10" Click="SeekBy_Click"
                                    Width="88" Height="36" Margin="10,0,0,0" FontSize="12"
                                    Style="{StaticResource BtnDark}" Focusable="False"/>
                            <Button Content="前进10秒" Tag="10" Click="SeekBy_Click"
                                    Width="88" Height="36" Margin="10,0,0,0" FontSize="12"
                                    Style="{StaticResource BtnDark}" Focusable="False"/>
                            <TextBlock x:Name="TimeText" Text="00:00 / 00:00"
                                       Foreground="#D0D0D8" VerticalAlignment="Center" Margin="16,0,0,0"
                                       FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="倍速" Foreground="#A0A0A8" VerticalAlignment="Center"
                                       FontSize="12" Margin="0,0,8,0"/>
                            <Border Background="#22FFFFFF" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="0.5x" Tag="0.5" Click="Speed_Click" Width="46" Height="30" FontSize="12" x:Name="Sp05" Focusable="False"/>
                                    <Button Content="1.0x" Tag="1" Click="Speed_Click" Width="46" Height="30" FontSize="12" x:Name="Sp1" Focusable="False"/>
                                    <Button Content="1.5x" Tag="1.5" Click="Speed_Click" Width="46" Height="30" FontSize="12" x:Name="Sp15" Focusable="False"/>
                                    <Button Content="2.0x" Tag="2" Click="Speed_Click" Width="46" Height="30" FontSize="12" x:Name="Sp2" Focusable="False"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="音量" Foreground="#A0A0A8" VerticalAlignment="Center"
                                       FontSize="12" Margin="16,0,8,0"/>
                            <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="80"
                                    ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Focusable="False"/>
                            <Button Content="全屏" Click="Fullscreen_Click" Width="56" Height="36" Margin="16,0,0,0"
                                    FontSize="12" Style="{StaticResource BtnDark}" Focusable="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="Drawer" Panel.ZIndex="30" Width="220" HorizontalAlignment="Right"
                    Background="#F0121216" Visibility="Collapsed" Margin="0,56,0,140">
                <ListBox x:Name="EpisodeList" Style="{StaticResource ListDark}"
                         ItemContainerStyle="{StaticResource ListDarkItem}"
                         SelectionChanged="EpisodeList_SelectionChanged"/>
            </Border>

            <TextBlock x:Name="LoadingText" Panel.ZIndex="15" Text="加载中…" Foreground="#CCC"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
        </Grid>
    </Border>
</Window>
