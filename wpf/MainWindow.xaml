<Window x:Class="JukuWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="短剧库" Height="800" Width="1280" MinWidth="1080" MinHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
    <!-- 窗体：圆角 + 轻阴影 -->
    <Border CornerRadius="18" Background="White" SnapsToDevicePixels="True" ClipToBounds="True">
        <Border CornerRadius="18" BorderBrush="#0D000000" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.Background>
                        <SolidColorBrush Color="#F7F7FA"/>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" x:Name="TitleText" Text="短剧库"
                               FontSize="13" FontWeight="Medium" Foreground="#6E6E73"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Ideal"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Stretch">
                        <Button Width="46" Height="52" Click="MinBtn_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent">
                                        <Path x:Name="p" Data="M 0,0 L 10,0" Stroke="#6E6E73" StrokeThickness="1.2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#14000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="46" Height="52" Click="MaxBtn_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent">
                                        <Rectangle x:Name="r" Width="10" Height="10" Stroke="#6E6E73" StrokeThickness="1.2"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#14000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="46" Height="52" Click="CloseBtn_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent">
                                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#6E6E73" StrokeThickness="1.2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#C50F1F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容 -->
                <Grid Grid.Row="1">

                    <!-- ===== 登录 ===== -->
                    <Grid x:Name="LoginPanel" Background="{StaticResource LightBg}">
                        <Border Width="400" VerticalAlignment="Center" Background="White"
                                CornerRadius="20" Padding="36,32">
                            <StackPanel>
                                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                                        Background="{StaticResource Accent}">
                                    <TextBlock Text="剧" FontSize="28" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="短剧库" FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="#1D1D1F" Margin="0,14,0,0"/>
                                <TextBlock Text="连接服务器后进入剧库 · 配置保存在本机"
                                           FontSize="13" Foreground="#6E6E73" HorizontalAlignment="Center"
                                           Margin="0,8,0,20" TextWrapping="Wrap"/>
                                <TextBlock Text="服务器地址" FontSize="12" Foreground="#8E8E93" FontWeight="Medium"/>
                                <Border CornerRadius="10" Background="#F5F5F7" Margin="0,6,0,12">
                                    <TextBox x:Name="ServerBox" BorderThickness="0" Background="Transparent"
                                             Height="40" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                                </Border>
                                <TextBlock Text="账号" FontSize="12" Foreground="#8E8E93" FontWeight="Medium"/>
                                <Border CornerRadius="10" Background="#F5F5F7" Margin="0,6,0,12">
                                    <TextBox x:Name="UserBox" BorderThickness="0" Background="Transparent"
                                             Height="40" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                                </Border>
                                <TextBlock Text="密码" FontSize="12" Foreground="#8E8E93" FontWeight="Medium"/>
                                <Border CornerRadius="10" Background="#F5F5F7" Margin="0,6,0,18">
                                    <PasswordBox x:Name="PassBox" BorderThickness="0" Background="Transparent"
                                                 Height="40" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"
                                                 KeyDown="PassBox_KeyDown"/>
                                </Border>
                                <Button Content="进入剧库" Style="{StaticResource PrimaryBtn}"
                                        HorizontalAlignment="Stretch" Height="42" FontSize="14"
                                        Click="Login_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4D9FFF" Offset="0"/>
                                            <GradientStop Color="#6C5CE7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                <TextBlock x:Name="LoginError" Foreground="#FF3B30" FontSize="12"
                                           Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== 主界面 ===== -->
                    <Grid x:Name="MainPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 侧栏 -->
                        <Grid Grid.Column="0">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#ECECF1" Offset="0"/>
                                    <GradientStop Color="#E4E4EA" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="12,20,12,0">
                                <Button Focusable="False" FocusVisualStyle="{x:Null}" x:Name="NavLibrary" Content="剧库" Style="{StaticResource NavLight}"
                                        Tag="selected" Click="Nav_Click" Margin="0,0,0,6" Foreground="#1D1D1F"/>
                                <Button Focusable="False" FocusVisualStyle="{x:Null}" x:Name="NavSettings" Content="设置" Style="{StaticResource NavLight}"
                                        Click="Nav_Click" Foreground="#6E6E73"/>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="12,12,12,16" CornerRadius="14"
                                    Background="#FFFFFF" Opacity="0.75" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="服务器" FontSize="11" Foreground="#8E8E93"/>
                                    <TextBlock x:Name="ServerLabel" Text="—" FontSize="11"
                                               Foreground="#1D1D1F" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AccountLabel" Text="" FontSize="11"
                                               Foreground="#6E6E73" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 内容区 -->
                        <Grid Grid.Column="1" Background="#F5F5F7">

                            <!-- 剧库 -->
                            <Grid x:Name="LibraryView">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="28,24,28,0">
                                    <StackPanel>
                                        <TextBlock Text="短剧库" FontSize="28" FontWeight="Bold" Foreground="#1D1D1F"/>
                                        <TextBlock x:Name="SubText" Text="发现更多好看的故事"
                                                   FontSize="13" Foreground="#6E6E73" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Border Width="220" Height="36" CornerRadius="18" Background="#ECECF1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="14,0,6,0">
                                        <Grid>
                                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center" FontSize="13"
                                                     Foreground="#1D1D1F" KeyDown="Search_KeyDown"/>
                                            <TextBlock Text="搜索剧名…" FontSize="13" Foreground="#8E8E93"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       x:Name="SearchHint"/>
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{StaticResource Accent}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="⌕" Foreground="White" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 筛选 Chip -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,18,28,20">
                                    <Button x:Name="ChipHongguo" Content="红果" Tag="hongguo"
                                            Style="{StaticResource ChipBtn}" Click="ChipSource_Click"
                                            Padding="16,0" Margin="0,0,10,0">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4D9FFF" Offset="0"/>
                                                <GradientStop Color="#6C5CE7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Foreground>White</Button.Foreground>
                                    </Button>
                                    <Button x:Name="ChipHuangguo" Content="黄果" Tag="huangguo"
                                            Style="{StaticResource ChipBtn}" Click="ChipSource_Click"
                                            Padding="16,0" Margin="0,0,10,0" Background="#ECECF1"/>
                                    <Button x:Name="ChipHuangdou" Content="黄豆" Tag="huangdou"
                                            Style="{StaticResource ChipBtn}" Click="ChipSource_Click"
                                            Padding="16,0" Margin="0,0,10,0" Background="#ECECF1"/>
                                    <Button x:Name="ChipAll" Content="全部" Tag="all"
                                            Style="{StaticResource ChipBtn}" Click="ChipSource_Click"
                                            Padding="16,0" Margin="0,0,10,0" Background="#ECECF1"/>
                                    <Button x:Name="ChipSort" Content="排序: 随机"
                                            Style="{StaticResource ChipBtn}" Click="ChipSort_Click"
                                            Padding="16,0" Margin="0,0,10,0" Background="#ECECF1"/>
                                    <Button Content="隐藏VIP" Style="{StaticResource ChipBtn}" Click="HideVip_Click"
                                            Padding="16,0" Margin="0,0,10,0" Background="#ECECF1"/>
                                    <Button Content="刷新" Style="{StaticResource NavLight}" Click="Refresh_Click"
                                            Height="30" Padding="16,0" Background="#ECECF1"/>
                                </StackPanel>

                                <!-- 海报网格 -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollViewer_ScrollChanged"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DramaList" Margin="20,0,28,24">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 设置 -->
                            <Grid x:Name="SettingsView" Visibility="Collapsed">
                                <ScrollViewer>
                                    <StackPanel Margin="28,24,28,32">
                                        <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Foreground="#1D1D1F"/>
                                        <TextBlock Text="外观与播放偏好 · 开关一律靠右" FontSize="13"
                                                   Foreground="#6E6E73" Margin="0,6,0,22"/>

                                        <Border Background="#F5F5F7" CornerRadius="16" Padding="22,8" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="账号" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#4D9FFF" Margin="0,12,0,4"/>
                                                <TextBlock x:Name="SetUser" FontSize="15" FontWeight="Medium"
                                                           Foreground="#1D1D1F" Margin="0,6,0,0"/>
                                                <TextBlock x:Name="SetServer" FontSize="12" Foreground="#6E6E73"
                                                           Margin="0,4,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Button Content="退出账号登录" Style="{StaticResource PrimaryBtn}"
                                                            Click="Logout_Click" Background="#4D9FFF"/>
                                                    <Button Content="重新配置服务器" Style="{StaticResource NavLight}"
                                                            Click="Reconfig_Click" Margin="10,0,0,0"
                                                            Background="#ECECF1"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#F5F5F7" CornerRadius="16" Padding="22,8" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="内容源" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#4D9FFF" Margin="0,12,0,4"/>
                                                <TextBlock Text="控制剧库显示哪些站源，关闭后不再展示。红果始终显示。"
                                                           FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap"
                                                           Margin="0,4,0,8"/>
                                                <DockPanel Margin="0,8,0,0">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="黄果" FontSize="15" FontWeight="Medium"/>
                                                        <TextBlock Text="黄果视频、原创等（含 cloudfront）"
                                                                   FontSize="12" Foreground="#6E6E73"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkHuangguo" HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Checked="Src_Changed" Unchecked="Src_Changed"/>
                                                </DockPanel>
                                                <Rectangle Height="1" Fill="#E5E5EA" Margin="0,12,0,0"/>
                                                <DockPanel Margin="0,12,0,8">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="黄豆" FontSize="15" FontWeight="Medium"/>
                                                        <TextBlock Text="黄豆及其子源" FontSize="12" Foreground="#6E6E73"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkHuangdou" HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Checked="Src_Changed" Unchecked="Src_Changed"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#F5F5F7" CornerRadius="16" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#4D9FFF"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock Text="短剧库 Windows 桌面端" FontSize="15"
                                                               FontWeight="Medium"/>
                                                    <Border Background="{StaticResource Accent}" CornerRadius="12"
                                                            Padding="12,5" Margin="12,0,0,0">
                                                        <TextBlock Text="v0.1.0" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="圆角 · 连续 · 留白 · 开关在右" FontSize="12"
                                                           Foreground="#6E6E73" Margin="0,8,0,4"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
