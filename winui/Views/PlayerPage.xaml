<Page
    x:Class="JukuWinUI.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0A0A0C">
    <Grid>
        <!-- 视频铺满 -->
        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False"
                            Stretch="Uniform" />

        <!-- 顶栏 -->
        <Grid x:Name="TopBar" Height="48" VerticalAlignment="Top" Background="#E6121216">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,8,0" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource JukuAccentBrush}">
                    <TextBlock Text="剧" FontSize="12" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <TextBlock x:Name="EpText" Foreground="#A1A1A6" FontSize="11" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Spacing="0">
                <Button Content="选集" Click="ToggleEpisodes_Click" Width="56"
                        Background="Transparent" Foreground="#C8C8D0" />
                <Button Content="最小化" Click="MinBtn_Click" Width="56"
                        Background="Transparent" Foreground="#A0A0A8" />
                <Button Content="关闭" Click="CloseBtn_Click" Width="52"
                        Background="Transparent" Foreground="#A0A0A8" />
            </StackPanel>
        </Grid>

        <!-- 底部叠控 -->
        <Border x:Name="OverlayBar" VerticalAlignment="Bottom" Background="#E6121216" Padding="20,14">
            <StackPanel Spacing="12">
                <!-- 进度条 -->
                <Grid x:Name="SeekTrack" Height="6" Background="#33FFFFFF" CornerRadius="3"
                      PointerPressed="SeekTrack_PointerPressed">
                    <Border x:Name="SeekFill" Background="{StaticResource JukuAccentBrush}" CornerRadius="3"
                            HorizontalAlignment="Left" Width="0" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="PlayPauseBtn" Content="播放" Click="PlayPause_Click" Width="80"
                                Background="{StaticResource JukuAccentBrush}" Foreground="White" />
                        <Button Content="后退10秒" Tag="-10" Click="SeekBy_Click" Width="88"
                                Background="#2A2A30" Foreground="White" />
                        <Button Content="前进10秒" Tag="10" Click="SeekBy_Click" Width="88"
                                Background="#2A2A30" Foreground="White" />
                        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" Foreground="#D0D0D8"
                                   VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="倍速" Foreground="#A0A0A8" VerticalAlignment="Center" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="0.5x" Tag="0.5" Click="Speed_Click" Width="46" Height="28"
                                    Background="#2A2A30" Foreground="White" />
                            <Button Content="1.0x" Tag="1" Click="Speed_Click" Width="46" Height="28"
                                    Background="{StaticResource JukuAccentBrush}" Foreground="White" />
                            <Button Content="1.5x" Tag="1.5" Click="Speed_Click" Width="46" Height="28"
                                    Background="#2A2A30" Foreground="White" />
                            <Button Content="2.0x" Tag="2" Click="Speed_Click" Width="46" Height="28"
                                    Background="#2A2A30" Foreground="White" />
                        </StackPanel>
                        <TextBlock Text="音量" Foreground="#A0A0A8" VerticalAlignment="Center" FontSize="12" />
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="80"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <Button Content="全屏" Click="Fullscreen_Click" Width="56"
                                Background="#2A2A30" Foreground="White" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 选集抽屉 -->
        <Border x:Name="Drawer" Width="220" HorizontalAlignment="Right" Background="#F0121216"
                Visibility="Collapsed" Margin="0,56,0,140">
            <ListView x:Name="EpisodeList" Background="Transparent"
                      SelectionChanged="EpisodeList_SelectionChanged" />
        </Border>

        <TextBlock x:Name="LoadingText" Text="加载中…" Foreground="#CCC"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
    </Grid>
</Page>
