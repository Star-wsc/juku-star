<Page
    x:Class="JukuWinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JukuBgBrush}">
    <Grid Padding="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="短剧库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubText" Text="发现更多好看的故事" Style="{StaticResource PageSubStyle}" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Width="220" Height="36"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            PlaceholderText="搜索剧名…" QueryIcon="Find"
                            QuerySubmitted="SearchBox_QuerySubmitted" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,18">
            <Button x:Name="ChipHongguo" Content="红果" Tag="hongguo" Style="{StaticResource ChipSelectedStyle}" Click="ChipSource_Click" />
            <Button x:Name="ChipHuangguo" Content="黄果" Tag="huangguo" Style="{StaticResource ChipStyle}" Click="ChipSource_Click" Visibility="Collapsed" />
            <Button x:Name="ChipHuangdou" Content="黄豆" Tag="huangdou" Style="{StaticResource ChipStyle}" Click="ChipSource_Click" Visibility="Collapsed" />
            <Button x:Name="ChipAll" Content="全部" Tag="all" Style="{StaticResource ChipStyle}" Click="ChipSource_Click" />
            <Button x:Name="ChipSort" Content="排序: 随机" Style="{StaticResource ChipStyle}" Click="ChipSort_Click" />
            <Button x:Name="ChipHideVip" Content="隐藏VIP" Style="{StaticResource ChipStyle}" Click="ChipHideVip_Click" />
            <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshBtn_Click" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DramaGrid" />
        </ScrollViewer>
    </Grid>
</Page>
