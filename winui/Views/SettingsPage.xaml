<Page
    x:Class="JukuWinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JukuBgBrush}">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,40">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="外观与播放偏好 · 开关一律靠右" Style="{StaticResource PageSubStyle}" />

            <Border Background="{StaticResource JukuFillBrush}" CornerRadius="16" Padding="22,8" Margin="0,22,0,16">
                <StackPanel>
                    <TextBlock Text="账号" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JukuAccentBrush}" Margin="0,10,0,4" />
                    <TextBlock x:Name="UserText" FontSize="15" FontWeight="Medium" />
                    <TextBlock x:Name="ServerText" FontSize="12" Foreground="{StaticResource JukuTextSecondaryBrush}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="重新配置服务器" Style="{StaticResource SecondaryButtonStyle}" Click="ReconfigBtn_Click" />
                        <Button Content="退出账号登录" Style="{StaticResource PrimaryButtonStyle}" Click="LogoutBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JukuFillBrush}" CornerRadius="16" Padding="22,8" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="内容源" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JukuAccentBrush}" Margin="0,10,0,4" />
                    <TextBlock Text="控制剧库显示哪些站源，关闭后该剧集不再展示。红果始终显示。" FontSize="12"
                               Foreground="{StaticResource JukuTextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="黄果" FontSize="15" FontWeight="Medium" />
                            <TextBlock Text="黄果视频、黄果原创等（含 cloudfront）" FontSize="12" Foreground="{StaticResource JukuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwHuangguo" Grid.Column="1" OnContent="" OffContent="" Toggled="SwHuangguo_Toggled" />
                    </Grid>
                    <Grid Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="黄豆" FontSize="15" FontWeight="Medium" />
                            <TextBlock Text="黄豆及其子源" FontSize="12" Foreground="{StaticResource JukuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwHuangdou" Grid.Column="1" OnContent="" OffContent="" Toggled="SwHuangdou_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JukuFillBrush}" CornerRadius="16" Padding="22,8" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="播放" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JukuAccentBrush}" Margin="0,10,0,4" />
                    <Grid Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自动播放下一集" FontSize="15" FontWeight="Medium" />
                            <TextBlock Text="当前集结束后自动切换" FontSize="12" Foreground="{StaticResource JukuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwAutoNext" Grid.Column="1" OnContent="" OffContent="" Toggled="SwAutoNext_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JukuFillBrush}" CornerRadius="16" Padding="22,8" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="剧库" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JukuAccentBrush}" Margin="0,10,0,4" />
                    <Grid Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="随机排序" FontSize="15" FontWeight="Medium" />
                            <TextBlock Text="每次刷新重新洗牌" FontSize="12" Foreground="{StaticResource JukuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwRandom" Grid.Column="1" OnContent="" OffContent="" Toggled="SwRandom_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JukuFillBrush}" CornerRadius="16" Padding="22,16">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JukuAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <TextBlock Text="短剧库 Windows 桌面端" FontSize="15" FontWeight="Medium" />
                        <Border Background="{StaticResource JukuAccentBrush}" CornerRadius="12" Padding="12,4">
                            <TextBlock Text="v0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="圆角 · 连续 · 留白 · 开关在右" FontSize="12"
                               Foreground="{StaticResource JukuTextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
