<Page
    x:Class="JukuWinUI.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JukuBgBrush}">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="16">
            <Button Content="← 返回" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="BackBtn_Click" />
            <StackPanel Orientation="Horizontal" Spacing="28">
                <Border Width="200" Height="268" CornerRadius="16" Background="{StaticResource JukuFillBrush}">
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Spacing="10" MaxWidth="640">
                    <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="MetaText" FontSize="13" Foreground="{StaticResource JukuTextSecondaryBrush}" />
                    <TextBlock x:Name="DescText" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource JukuTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button Content="▶ 播放第 1 集" Style="{StaticResource PrimaryButtonStyle}" Click="PlayBtn_Click" />
                        <Button Content="追剧" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="选集" FontSize="17" FontWeight="SemiBold" />
            <ItemsControl x:Name="EpisodeList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
